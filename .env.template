# Supabase — variables de servidor (astro:env, context: 'server', access: 'secret').
# URL del proyecto y clave publishable/anon. Nunca deben llevar prefijo PUBLIC_.
SUPABASE_URL=
SUPABASE_KEY=

# Solo para la CLI/MCP (migraciones y administración). Nunca se expone al cliente.
SUPABASE_DB_PASSWORD=XXXXXXXX

# Clave secreta admin server-only para auth.admin.generateLink (reemplaza a service_role).
# Solo servidor; nunca en cliente.
SUPABASE_SECRET_API_KEY=XXXXXXXX

# SMTP de Gmail para el envío de invitaciones (nodemailer). "De" = SMTP_USER.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=XXXXXXXX
SMTP_PASS=XXXXXXXX
