---
import BaseLayout from '../../components/ui/BaseLayout.astro'
import AlertError from '../../components/ui/AlertError.astro'
import AuthCard from '../../features/auth/components/AuthCard.astro'
import FormField from '../../features/auth/components/FormField.astro'
import PasswordInput from '../../features/auth/components/PasswordInput.astro'

const MIN_PASSWORD_LENGTH = 8;
const ERROR_MESSAGES = {
	corta: 'La contraseña debe tener al menos 8 caracteres.',
	no_coinciden: 'Las contraseñas no coinciden.',
	update_failed: 'No se pudo guardar la contraseña. Inténtalo de nuevo.'
} as const;

// La sesión llega de verifyOtp en /auth/confirm (cookies httpOnly).
if (!Astro.locals.claims) {
	return Astro.redirect('/auth/login');
}

if (Astro.request.method === 'POST') {
	const formData = await Astro.request.formData().catch(() => null);
	const password = formData?.get('password');
	const passwordConfirm = formData?.get('password_confirm');

	// Validación antes de tocar Supabase
	if (typeof password !== 'string' || password.length < MIN_PASSWORD_LENGTH) {
		return Astro.redirect('/auth/update-password?error=corta');
	}
	if (password !== passwordConfirm) {
		return Astro.redirect('/auth/update-password?error=no_coinciden');
	}

	const { error } = await Astro.locals.supabase.auth.updateUser({ password });
	if (error) {
		// Mensaje genérico: no se filtra el detalle de Supabase
		console.error('[update-password] updateUser falló:', error.message);
		return Astro.redirect('/auth/update-password?error=update_failed');
	}

	return Astro.redirect('/dashboard');
}

// Clave desconocida → undefined → null
const errorKey = Astro.url.searchParams.get('error');
const errorMessage =
	(errorKey && ERROR_MESSAGES[errorKey as keyof typeof ERROR_MESSAGES]) || null;
---

<BaseLayout title="Elige tu contraseña | Dona de sangre">
	<AuthCard>
		<h1 class="card-title justify-center text-2xl">Elige tu contraseña</h1>
		<p class="text-center text-sm opacity-70">
			Define tu contraseña para entrar a Dona de sangre. No la compartas con nadie.
		</p>
		{
			errorMessage && (
				<AlertError soft>
					<span>{errorMessage}</span>
					<a href="/auth/login" class="link">Ir a iniciar sesión</a>
				</AlertError>
			)
		}
		<form id="password-form" class="flex flex-col gap-4" method="post" action="/auth/update-password">
			<FormField id="password" label="Contraseña">
				<PasswordInput id="password" required minlength={8} autocomplete="new-password" />
			</FormField>
			<FormField id="password_confirm" label="Confirmar contraseña">
				<PasswordInput
					id="password_confirm"
					required
					minlength={8}
					autocomplete="new-password"
					toggleLabel="confirmación de contraseña"
				/>
			</FormField>
			<button id="password-submit" type="submit" class="btn btn-primary w-full">Guardar contraseña</button>
		</form>
	</AuthCard>

	<script>
		const form = document.getElementById('password-form')
		const submitButton = document.getElementById('password-submit')

		form?.addEventListener('submit', () => {
			if (!(submitButton instanceof HTMLButtonElement)) return

			submitButton.disabled = true
			submitButton.textContent = 'Guardando…'
		})
	</script>
</BaseLayout>
