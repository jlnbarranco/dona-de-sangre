---
import '../../styles/global.css'

const showError = Astro.url.searchParams.get('error') === 'invalid_credentials'
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Iniciar sesión | Dona de sangre</title>
	</head>
	<body class="bg-base-200">
		<main class="flex min-h-svh items-center justify-center p-4 sm:p-6">
			<section class="card w-full max-w-sm bg-base-100 shadow-xl">
				<div class="card-body gap-4">
					<h1 class="card-title justify-center text-2xl">Dona de sangre</h1>
					<form id="login-form" class="flex flex-col gap-4" method="post" action="/api/auth/login">
						{
							showError && (
								<div role="alert" class="alert alert-error alert-soft">
									<span>Correo o contraseña incorrectos</span>
								</div>
							)
						}
						<fieldset class="fieldset">
							<label class="label" for="email">Correo</label>
							<input id="email" name="email" type="email" class="input w-full" required autocomplete="email" />
						</fieldset>
						<fieldset class="fieldset">
							<label class="label" for="password">Contraseña</label>
							<div class="input w-full">
								<input id="password" name="password" type="password" class="grow" required autocomplete="current-password" />
								<button id="password-toggle" type="button" class="btn btn-ghost btn-square btn-sm hidden" aria-label="Mostrar contraseña">
									<svg data-icon="eye" class="size-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z" />
										<circle cx="12" cy="12" r="3" />
									</svg>
									<svg data-icon="eye-off" class="size-5 hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<path d="m3 3 18 18" />
										<path d="M10.6 10.6a2 2 0 0 0 2.8 2.8" />
										<path d="M9.9 5.2A10.7 10.7 0 0 1 12 5c6.4 0 10 7 10 7a15.7 15.7 0 0 1-4.1 4.9" />
										<path d="M6.6 6.6C3.7 8.5 2 12 2 12s3.6 7 10 7a10.7 10.7 0 0 0 5.4-1.5" />
									</svg>
								</button>
							</div>
							<div class="text-right">
								<a href="#" class="link link-hover text-sm">¿Olvidaste tu contraseña?</a>
							</div>
						</fieldset>
						<button id="login-submit" type="submit" class="btn btn-primary w-full">Iniciar sesión</button>
					</form>
				</div>
			</section>
		</main>

		<script>
			const form = document.getElementById('login-form')
			const submitButton = document.getElementById('login-submit')
			const passwordInput = document.getElementById('password')
			const passwordToggle = document.getElementById('password-toggle')
			const eyeIcon = passwordToggle?.querySelector('[data-icon="eye"]')
			const eyeOffIcon = passwordToggle?.querySelector('[data-icon="eye-off"]')

			if (passwordInput instanceof HTMLInputElement && passwordToggle instanceof HTMLButtonElement) {
				passwordToggle.classList.remove('hidden')
				passwordToggle.addEventListener('click', () => {
					const isPasswordHidden = passwordInput.type === 'password'
					passwordInput.type = isPasswordHidden ? 'text' : 'password'
					passwordToggle.setAttribute('aria-label', isPasswordHidden ? 'Ocultar contraseña' : 'Mostrar contraseña')
					eyeIcon?.classList.toggle('hidden', isPasswordHidden)
					eyeOffIcon?.classList.toggle('hidden', !isPasswordHidden)
				})
			}

			form?.addEventListener('submit', () => {
				if (!(submitButton instanceof HTMLButtonElement)) return

				submitButton.disabled = true
				submitButton.textContent = 'Ingresando…'
			})
		</script>
	</body>
</html>
