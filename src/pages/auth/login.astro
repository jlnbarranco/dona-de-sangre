---
import BaseLayout from '../../components/ui/BaseLayout.astro'
import AlertError from '../../components/ui/AlertError.astro'
import AuthCard from '../../features/auth/components/AuthCard.astro'
import FormField from '../../features/auth/components/FormField.astro'
import PasswordInput from '../../features/auth/components/PasswordInput.astro'

const ERROR_MESSAGES = {
	invalid_credentials: 'Correo o contraseña incorrectos',
	link_invalido: 'El enlace de invitación no es válido o ha caducado. Pide una nueva invitación al administrador.'
} as const;

// Clave desconocida → undefined → null
const errorKey = Astro.url.searchParams.get('error');
const errorMessage =
	(errorKey && ERROR_MESSAGES[errorKey as keyof typeof ERROR_MESSAGES]) || null;
---

<BaseLayout title="Iniciar sesión | Dona de sangre">
	<AuthCard>
		<h1 class="card-title justify-center text-2xl">Dona de sangre</h1>
		<form id="login-form" class="flex flex-col gap-4" method="post" action="/api/auth/login">
			{
				errorMessage && (
					<AlertError soft>
						<span>{errorMessage}</span>
					</AlertError>
				)
			}
			<FormField id="email" label="Correo" type="email" required autocomplete="email" />
			<FormField id="password" label="Contraseña">
				<PasswordInput />
				<div class="text-right">
					<a href="#" class="link link-hover text-sm">¿Olvidaste tu contraseña?</a>
				</div>
			</FormField>
			<button id="login-submit" type="submit" class="btn btn-primary w-full">Iniciar sesión</button>
		</form>
	</AuthCard>

	<script>
		const form = document.getElementById('login-form')
		const submitButton = document.getElementById('login-submit')

		form?.addEventListener('submit', () => {
			if (!(submitButton instanceof HTMLButtonElement)) return

			submitButton.disabled = true
			submitButton.textContent = 'Ingresando…'
		})
	</script>
</BaseLayout>
