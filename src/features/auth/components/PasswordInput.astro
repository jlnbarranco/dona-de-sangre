---
import { Eye, EyeOff } from '@lucide/astro'

interface Props {
	id: string
	name?: string
	autocomplete?: string
	required?: boolean
	minlength?: number | string
	toggleLabel?: string
}

const {
	id,
	name = id,
	autocomplete = 'current-password',
	required = false,
	minlength,
	toggleLabel = 'contraseña'
} = Astro.props
---

<div class="input w-full" data-password-input>
	<input
		id={id}
		name={name}
		type="password"
		class="grow"
		required={required}
		minlength={minlength}
		autocomplete={autocomplete}
	/>
	<button
		type="button"
		class="btn btn-ghost btn-square btn-sm hidden"
		data-label={toggleLabel}
		aria-label={`Mostrar ${toggleLabel}`}
	>
		<Eye data-icon="eye" size={20} />
		<EyeOff data-icon="eye-off" size={20} class="hidden" />
	</button>
</div>

<script>
	document.querySelectorAll('[data-password-input]').forEach((instance) => {
		const input = instance.querySelector('input')
		const toggle = instance.querySelector('button')
		if (!(input instanceof HTMLInputElement) || !(toggle instanceof HTMLButtonElement)) return

		const label = toggle.dataset.label ?? 'contraseña'
		const eyeIcon = toggle.querySelector('[data-icon="eye"]')
		const eyeOffIcon = toggle.querySelector('[data-icon="eye-off"]')

		toggle.classList.remove('hidden')
		toggle.addEventListener('click', () => {
			const isPasswordHidden = input.type === 'password'
			input.type = isPasswordHidden ? 'text' : 'password'
			toggle.setAttribute('aria-label', isPasswordHidden ? `Ocultar ${label}` : `Mostrar ${label}`)
			eyeIcon?.classList.toggle('hidden', isPasswordHidden)
			eyeOffIcon?.classList.toggle('hidden', !isPasswordHidden)
		})
	})
</script>
